package com.fingenie.wealth_service.controller;

import java.util.List;
import java.util.Map;

import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.fingenie.wealth_service.dto.InvestmentDTO;
import com.fingenie.wealth_service.entity.Investment;
import com.fingenie.wealth_service.service.IInvestmentService;

@RestController
@RequestMapping("/investments")
public class InvestmentController {

    private final IInvestmentService investmentService;

    public InvestmentController(IInvestmentService investmentService) {
        this.investmentService = investmentService;
    }

    
    @GetMapping("/all")
    public List<Investment> getAllInvestments() {
        return investmentService.getAllInvestments();
    }

    @PostMapping("/add")
    public Map<String, Object> addInvestment(@RequestBody InvestmentDTO dto) {

        Investment saved = investmentService.addInvestment(dto);
        return Map.of(
                "message", "Investment created successfully",
                "data", saved);
    }

    @GetMapping("/id/{id}")
    public Investment getInvestmentById(@PathVariable Long id) {
        return investmentService.getInvestmentById(id);
    }

    @PutMapping("/update/{id}")
    public Map<String, Object> updateInvestment(@RequestBody InvestmentDTO dto,
                                                @PathVariable Long id) {

        Investment updated = investmentService.updateInvestment(dto, id);
        return Map.of(
                "message", "Investment updated successfully",
                "data", updated);
    }

    @DeleteMapping("/close/{id}")
    public Map<String, Object> closeInvestment(@PathVariable Long id) {

        String message = investmentService.closeInvestmentById(id);
        return Map.of(
                "message", message);
    }
    
}