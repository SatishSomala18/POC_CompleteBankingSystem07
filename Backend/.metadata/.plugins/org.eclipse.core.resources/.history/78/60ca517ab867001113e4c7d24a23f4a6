server:
  port: 8080

spring:
  application:
    name: API_GATEWAY

  cloud:
    gateway:
      routes:
        - id: USER-MICROSERVICE
          uri: lb://USER-MICROSERVICE
          predicates:
            - Path=/users/**,/usersecurity/**,/creditprofile/**

        - id: PRODUCT-MICROSERVICE
          uri: lb://PRODUCT-MICROSERVICE
          predicates:
            - Path=/product/**

        - id: ORDER-MICROSERVICE
          uri: lb://ORDER-MICROSERVICE
          predicates:
            - Path=/orders/**,/orderitem/**

eureka:
  client:
    register-with-eureka: true
    fetch-registry: true
    service-url:
      defaultZone: http://localhost:8761/eureka