server:
  port: 8080

spring:
  application:
    name: API-GATEWAY

  cloud:
    gateway:
      routes:
        - id: USER-SERVICE
          uri: lb://USER-SERVICE
          predicates:
            - Path=/users/**,/usersecurity/**,/creditprofiles/**

        - id: BANKING-SERVICE
          uri: lb://BANKING-SERVICE
          predicates:
            - Path=/account/**,/transaction/**

        - id: WEALTH-SERVICE
          uri: lb://WEALTH-SERVICE
          predicates:
            - Path=/investments/**,/loans/**,/userinvestments/**

        - id: AUTH-SERVICE
          uri: lb://AUTH-SERVICE
          predicates:
            - Path=/auth/**

      globalcors:
        corsConfigurations:
          '[/**]':
            allowedOrigins:
              - "http://localhost:3001"
            allowedMethods:
              - GET
              - POST
              - PUT
              - DELETE
              - OPTIONS
            allowedHeaders: "*"
            allowCredentials: true

eureka:
  client:
    register-with-eureka: true
    fetch-registry: true
    service-url:
      defaultZone: http://localhost:8761/eureka