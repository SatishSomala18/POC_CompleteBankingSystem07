package com.fingenie.wealth_service.service;

import java.util.ArrayList;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpEntity;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpMethod;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import com.fingenie.wealth_service.dto.Account;
import com.fingenie.wealth_service.dto.DepositRequestDTO;
import com.fingenie.wealth_service.dto.LoanRequestDTO;
import com.fingenie.wealth_service.dto.LoanResponseDTO;
import com.fingenie.wealth_service.dto.UserResponseDTO;
import com.fingenie.wealth_service.entity.Loan;
import com.fingenie.wealth_service.entity.Transaction;
import com.fingenie.wealth_service.repository.LoanRepository;

import jakarta.servlet.http.HttpServletRequest;

@Service
public class LoanServiceImp implements ILoanService {

    private final LoanRepository loanRepository;
    private final EMICalculatorService emiService;

    public LoanServiceImp(LoanRepository loanRepository, EMICalculatorService emiService) {
        this.loanRepository = loanRepository;
        this.emiService = emiService;
    }
    
    
    @Autowired
	RestTemplate rt;

	@Autowired
	private HttpServletRequest request;
    @Override
    public LoanResponseDTO applyLoan(LoanRequestDTO dto) {


        if (dto.getAmount() <= 0) {
            throw new RuntimeException("Loan amount must be greater than 0");
        }

        if (dto.getTenureMonths() <= 0) {
            throw new RuntimeException("Tenure must be greater than 0");
        }
 	
        Account acc=getAccount(dto.getAccountId());
        
        Loan loan = new Loan();
        loan.setAccountId(dto.getAccountId());
        loan.setUserId(acc.getUserId());
        loan.setAmount(dto.getAmount());
        loan.setTenureMonths(dto.getTenureMonths());

        loan.setStatus("PENDING");

        double emi =emiService.calculateEmi(dto.getAmount(),10,dto.getTenureMonths());
        		
        		
        loan.setEmi(emi);

        Loan l=loanRepository.save(loan);
        return convertToResponseDTO(l);
    }
    
    @Override
	public LoanResponseDTO updateLoan(Long loanId, LoanRequestDTO dto) {

	    if (loanId == null) {
	        throw new RuntimeException("Loan ID cannot be null");
	    }

	    Loan existingLoan = loanRepository.findById(loanId)
	            .orElseThrow(() -> new RuntimeException(
	                    "Loan not found with ID: " + loanId));

	    if (dto.getAmount() <= 0) {
	        throw new RuntimeException("Loan amount must be greater than 0");
	    }

	    if (dto.getTenureMonths() <= 0) {
	        throw new RuntimeException("Tenure must be greater than 0");
	    }

	    existingLoan.setAmount(dto.getAmount());
	    existingLoan.setTenureMonths(dto.getTenureMonths());

	    double emi = dto.getAmount() / dto.getTenureMonths();
	    existingLoan.setEmi(emi);

	    Loan l= loanRepository.save(existingLoan);
	    return convertToResponseDTO(l);
	}

    
	@Override
	public LoanResponseDTO findById(Long id) {

	    if (id == null) {
	        throw new RuntimeException("Loan ID cannot be null");
	    }

	    Loan l= loanRepository.findById(id)
	            .orElseThrow(() -> new RuntimeException("Loan not found with ID: " + id));
	    
	    return convertToResponseDTO(l);
	}

	public EMICalculatorService getEmiService() {
		return emiService;
	}
	@Override
	public List<LoanResponseDTO> getAllLoans() {
		List<Loan> loans=loanRepository.findAll();
		
		List<LoanResponseDTO> res=new ArrayList<>();
		
		for(Loan l:loans) {
			res.add(convertToResponseDTO(l));
		}
		return res;
	}
	
	@Override
	public LoanResponseDTO approveLoan(Long loanId) {

	    Loan loan = loanRepository.findById(loanId)
	            .orElseThrow(() -> new RuntimeException("Loan not found"));

	    if ("APPROVED".equals(loan.getStatus())) {
	        throw new RuntimeException("Loan is already approved");
	    }

	    if ("REJECTED".equals(loan.getStatus())) {
	        throw new RuntimeException("Rejected loan cannot be approved");
	    }

	    loan.setStatus("APPROVED");

	    Loan l= loanRepository.save(loan);
	    return convertToResponseDTO(l);
	}


	@Override
	public LoanResponseDTO rejectLoan(Long loanId) {

	    Loan loan = loanRepository.findById(loanId)
	            .orElseThrow(() -> new RuntimeException("Loan not found"));

	    if ("REJECTED".equals(loan.getStatus())) {
	        throw new RuntimeException("Loan is already rejected");
	    }

	    if ("APPROVED".equals(loan.getStatus())) {
	        throw new RuntimeException("Approved loan cannot be rejected");
	    }

	    loan.setStatus("REJECTED");

	    return loanRepository.save(loan);
	}
	

	
	
	@Override
	public void deleteById(Long id) {

	    if (!loanRepository.existsById(id)) {
	        throw new RuntimeException("Loan not found with ID: " + id);
	    }

	    loanRepository.deleteById(id);
	}
	


	@Override
	public List<LoanResponseDTO> findByStatus(String status) {
		
		return loanRepository.findByStatus(status);
	}
	
	
	public Account getAccount(Long accountId) {

		String authHeader = request.getHeader("Authorization");

		HttpHeaders headers = new HttpHeaders();

		headers.set("Authorization", authHeader);

		HttpEntity<String> entity = new HttpEntity<>(headers);

		String url = "http://BANKING-SERVICE/account/getaccountbyid/" + accountId;

		ResponseEntity<Account> response = rt.exchange(url, HttpMethod.GET, entity, Account.class);

		return response.getBody();
	}


	public Transaction depositAmount(DepositRequestDTO dto) {

		String authHeader = request.getHeader("Authorization");

		HttpHeaders headers = new HttpHeaders();
		headers.set("Authorization", authHeader);

		HttpEntity<DepositRequestDTO> entity = new HttpEntity<>(dto, headers);

		String url = "http://BANKING-SERVICE/transaction/deposit";

		ResponseEntity<Transaction> response = rt.exchange(url, HttpMethod.POST, entity, Transaction.class);

		return response.getBody();
	}
	public UserResponseDTO getUser(Long userId) {

		String authHeader = request.getHeader("Authorization");

		HttpHeaders headers = new HttpHeaders();

		headers.set("Authorization", authHeader);

		HttpEntity<String> entity = new HttpEntity<>(headers);

		String url = "http://USER-SERVICE/users/getuserbyid/" + userId;

		ResponseEntity<UserResponseDTO> response = rt.exchange(url, HttpMethod.GET, entity, UserResponseDTO.class);

		return response.getBody();
	}
	
	public LoanResponseDTO convertToResponseDTO(Loan loan) {
		
		LoanResponseDTO dto=new LoanResponseDTO();
		
		UserResponseDTO user=getUser(loan.getUserId());
		
		dto.setLoanId(loan.getId());
		dto.setAmount(loan.getAmount());
		dto.setTenureMonths(loan.getTenureMonths());
		dto.setStatus(loan.getStatus());
		dto.setEmi(loan.getEmi());
		dto.setAccountId(loan.getAccountId());
		dto.setUserId(loan.getUserId());
		dto.setName(user.getName());
		
		return dto;
		
	}
}